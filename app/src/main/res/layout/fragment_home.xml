<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Eschaton Deck Tracker"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Current Deck Stats"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvZeal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Zeal: 0"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvDivination"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Divination: 0"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvInfluence"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Influence: 0"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvAggression"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Aggression: 0"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvScour"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Scour: 0"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvInspire"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Inspire: 0"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvPointValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Point Value: 0"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvTotalCards"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cards Remaining: 0"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewDeck"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="View My Deck"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"
            app:backgroundTint="@color/primary"
            app:cornerRadius="8dp"
            app:icon="@android:drawable/ic_menu_view"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCultistDeck"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Cultist Deck"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"
            app:backgroundTint="@color/secondary"
            app:cornerRadius="8dp"
            app:icon="@android:drawable/ic_menu_gallery"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNeutralDeck"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Neutral Deck"
            android:textSize="16sp"
            app:backgroundTint="@color/accent"
            app:cornerRadius="8dp"
            app:icon="@android:drawable/ic_menu_gallery"
            app:iconGravity="textStart" />

    </LinearLayout>

</ScrollView>